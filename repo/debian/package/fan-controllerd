#!/usr/bin/env python3
import urllib.request
import json
import os
from pathlib import Path
from dataclasses import dataclass

release_endpoint = "https://api.github.com/repos/wxx9248/PC-Fan-Controller/releases/latest"
staging_directory_path = Path("staging/pool/main")


@dataclass
class Downloadable:
    name: str
    url: str


# The release also carries the firmware and the status page, which are flashed to
# the controller rather than installed, so only the Debian packages are taken.
def fetch_downloadables():
    req = urllib.request.Request(
        release_endpoint,
        headers={
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28"
        }
    )
    with urllib.request.urlopen(req) as response:
        data = json.loads(response.read().decode())
        return [
            Downloadable(asset["name"], asset["browser_download_url"])
            for asset in data["assets"]
            if asset["name"].endswith(".deb")
        ]


def download(downloadable: Downloadable, path: Path):
    target_file_path = path / downloadable.name
    print(f"[i] Downloading {downloadable.name} to {target_file_path}")
    with open(target_file_path, "wb") as target_file:
        with urllib.request.urlopen(downloadable.url) as response:
            target_file.write(response.read())


def main():
    print(f"[i] Current working directory: {os.getcwd()}")
    staging_directory_path.mkdir(parents=True, exist_ok=True)
    downloadables = fetch_downloadables()
    if not downloadables:
        raise SystemExit(f"[!] The latest release at {release_endpoint} has no .deb asset")
    for downloadable in downloadables:
        download(downloadable, staging_directory_path)


if __name__ == "__main__":
    main()
