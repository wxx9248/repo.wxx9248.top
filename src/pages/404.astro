---
import Base from "@/layouts/Base.astro";
import PromptLine from "@/components/PromptLine.astro";
import StatusBar from "@/components/StatusBar.astro";
import { site } from "@/config/site";
---

<Base
  canonicalPath="/404.html"
  description={site.intro}
  noindex
  title={`Not found · ${site.title}`}
>
  <PromptLine path={[]}>
    cd <span data-missing-path></span>
  </PromptLine>
  <main>
    <h1>No such file or directory</h1>
    <p>
      <a href="/">go to /</a>
    </p>
  </main>
  <StatusBar summary="" />
</Base>

<script>
  import "@/scripts/not-found";
</script>

<style>
  main {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--page-padding);
  }

  h1 {
    font-size: var(--text-tagline);
    font-weight: 700;
    line-height: 1.3;
  }
</style>
