---
import { site } from "@/config/site";
---

<div class="intro">
  <h1>{site.title}</h1>
  <p>{site.intro}</p>
</div>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  h1 {
    color: var(--color-text-heading);
    font-size: var(--text-tagline);
    font-weight: 700;
    line-height: 1.3;
  }

  p {
    color: var(--color-text-secondary);
  }
</style>
